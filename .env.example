# Copia este fichero como .env.local y rellénalo con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Sin estas claves la web arranca igual, pero sin login.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Clave para cifrar DNI e IBAN (32 bytes en base64). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guárdala bien: si se pierde, los DNI e IBAN guardados no se pueden leer.
DATA_ENCRYPTION_KEY=

# Dirección pública de la web (para los enlaces de los correos). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo de la web (confirmaciones de inscripción y avisos de baja), por SMTP.
# Recomendado: el Gmail de la entidad con una "contraseña de aplicación" (Cuenta de Google → Seguridad → Verificación en
# dos pasos → Contraseñas de aplicaciones): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465.
# En local con Supabase: SMTP_HOST=127.0.0.1 y SMTP_PORT=54325 (los correos se ven en http://127.0.0.1:54324).
# Sin SMTP_HOST los correos no se envían, solo se anotan en la consola.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Família Amic <familiaamic@gmail.com>"
# Adónde llegan los avisos de baja (por defecto, el correo de la entidad).
ASSOCIATION_EMAIL=
